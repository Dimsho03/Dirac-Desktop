<UserControl
    x:Class="v2rayN.Desktop.Views.DiracHomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:MainWindowViewModel"
    Background="#111315">

    <!-- A small native Avalonia shell. Lucide-derived 24x24 line geometries;
         no icon font, SVG runtime or browser layer is required. -->
    <UserControl.Styles>
        <Style Selector="Button.diracNav">
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#959A9F"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12,12"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
        </Style>
        <Style Selector="Button.diracNav:pointerover">
            <Setter Property="Background" Value="#22262A"/>
            <Setter Property="Foreground" Value="#F2F3F4"/>
        </Style>
        <Style Selector="Button.diracNav.selected">
            <Setter Property="Background" Value="#2A2E32"/>
            <Setter Property="Foreground" Value="#F7F8F9"/>
        </Style>
        <Style Selector="Button.diracRow">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#1B1E20"/>
            <Setter Property="Foreground" Value="#E8EAEB"/>
            <Setter Property="BorderBrush" Value="#363B3F"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="15,13"/>
        </Style>
        <Style Selector="Button.diracRow:pointerover">
            <Setter Property="Background" Value="#24282B"/>
            <Setter Property="BorderBrush" Value="#525A60"/>
        </Style>
        <Style Selector="Button.diracRow.selected">
            <Setter Property="Background" Value="#292D30"/>
            <Setter Property="BorderBrush" Value="#BEC2C2"/>
        </Style>
        <Style Selector="Button.diracPower">
            <Setter Property="Background" Value="#1C1F21"/>
            <Setter Property="Foreground" Value="#EBEDED"/>
            <Setter Property="BorderBrush" Value="#71787C"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="58"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        <Style Selector="Button.diracPower:pointerover">
            <Setter Property="Background" Value="#262A2B"/>
            <Setter Property="BorderBrush" Value="#F0F1F1"/>
        </Style>
        <Style Selector="Button.diracPower.connected">
            <Setter Property="Background" Value="#1B2220"/>
            <Setter Property="BorderBrush" Value="#AAC5B1"/>
        </Style>
        <Style Selector="Border.diracHalo">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BoxShadow" Value="0 0 0 0 Transparent"/>
        </Style>
        <Style Selector="Border.diracHalo.connected">
            <Setter Property="Background" Value="#122B3B30"/>
            <Setter Property="BorderBrush" Value="#366A8471"/>
            <Setter Property="BoxShadow" Value="0 0 32 7 #3A74927A"/>
        </Style>
        <Style Selector="Button.diracSmall">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#BBC1C5"/>
            <Setter Property="BorderBrush" Value="#3B4146"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="10,8"/>
        </Style>
        <Style Selector="Button.diracSmall:pointerover">
            <Setter Property="Background" Value="#272C30"/>
            <Setter Property="Foreground" Value="#F7F8F8"/>
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="157,*">
        <!-- Left rail: monochrome, the only persistent navigation. -->
        <Border Grid.Column="0" Background="#17191B" BorderBrush="#303437" BorderThickness="0,0,1,0" Padding="13,23,12,18">
            <Grid RowDefinitions="Auto,68,Auto,Auto,Auto,Auto,*,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center" Margin="5,0,0,0">
                    <Viewbox Width="27" Height="27">
                        <Canvas Width="24" Height="24">
                            <!-- Temporary monochrome mark; the separately approved logo asset remains unchanged. -->
                            <Path Data="M3 2V22 M7 2V22 M11 3A9 9 0 0 1 11 21" Stroke="#F1F2F2" StrokeThickness="1.9" StrokeLineCap="Round" Fill="Transparent"/>
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="DIRAC" FontSize="17" FontWeight="SemiBold" CharacterSpacing="250" Foreground="#F3F3F3" VerticalAlignment="Center"/>
                </StackPanel>

                <Button Grid.Row="2" x:Name="btnDiracOverview" Classes="diracNav selected">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="19" Height="19">
                            <Path Data="m3 9 9-7 9 7 v11 a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22v-9h6v9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Главная" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="3" x:Name="btnDiracRoutingNav" Classes="diracNav" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="19" Height="19">
                            <Path Data="M3 17h4a2 2 0 0 0 2-2V7a4 4 0 0 1 4-4h8 M17 7l4-4-4-4 M3 17l4-4 M3 17l4 4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Маршрутизация" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="4" x:Name="btnDiracUpdatesNav" Classes="diracNav" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="19" Height="19">
                            <Path Data="M20 11a8 8 0 0 0-15-3 M4 4v4h4 M4 13a8 8 0 0 0 15 3 M20 20v-4h-4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Обновления" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Row="5" x:Name="btnDiracSettingsNav" Classes="diracNav" Margin="0,6,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="19" Height="19">
                            <Path Data="M4 21v-7 M4 10V3 M12 21v-9 M12 8V3 M20 21v-5 M20 12V3 M1 14h6 M9 8h6 M17 16h6" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/>
                        </Viewbox>
                        <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <StackPanel Grid.Row="7" Margin="10,0,0,0" Spacing="6">
                    <Border Height="1" Background="#323638"/>
                    <TextBlock Text="DIRAC DESKTOP" Foreground="#686F74" FontSize="10" Margin="0,11,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Compact content pages share one actual MainWindow and its existing CoreManager. -->
        <Grid Grid.Column="1" Margin="25,24,25,23">
            <Grid x:Name="panelDiracHome" RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Text="ПОДКЛЮЧЕНИЕ" Foreground="#858D93" FontSize="10" FontWeight="SemiBold" CharacterSpacing="140"/>
                <StackPanel Grid.Row="1" Spacing="0" VerticalAlignment="Center" HorizontalAlignment="Center" Width="310" MaxWidth="310">
                    <TextBlock x:Name="txtDiracConnection" Text="Не подключено" Foreground="#F0F1F1" FontSize="25" FontWeight="Medium" TextAlignment="Center" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="txtDiracConnectionHint" Text="Выберите профиль для подключения" Foreground="#8D9499" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,7,0,18"/>
                    <Border x:Name="diracConnectHalo" Classes="diracHalo" Width="158" Height="158" CornerRadius="79" BorderThickness="1" HorizontalAlignment="Center">
                        <Button x:Name="btnDiracConnect" Classes="diracPower" Width="114" Height="114" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Viewbox Width="32" Height="32">
                                <!-- Lucide power outline. -->
                                <Path Data="M18.36 6.64A9 9 0 1 1 5.64 6.64 M12 2v10" Stroke="#F2F3F3" StrokeThickness="1.5" StrokeLineCap="Round" Fill="Transparent"/>
                            </Viewbox>
                        </Button>
                    </Border>
                    <TextBlock x:Name="txtDiracAction" Text="Подключить" Foreground="#A5ABB0" FontSize="11" HorizontalAlignment="Center" Margin="0,10,0,0"/>
                </StackPanel>
                <StackPanel Grid.Row="2" Spacing="10">
                    <TextBlock Text="ПРОФИЛЬ" Foreground="#929B9F" FontSize="10" FontWeight="SemiBold" CharacterSpacing="110"/>
                    <ComboBox x:Name="cmbDiracProfile" MinHeight="43" HorizontalAlignment="Stretch" Background="#222527" Foreground="#F0F2F2" BorderBrush="#42484B" BorderThickness="1" CornerRadius="10"
                              ItemsSource="{Binding StatusBarViewModel.Servers}"
                              SelectedItem="{Binding StatusBarViewModel.SelectedServer, Mode=TwoWay}"
                              DisplayMemberBinding="{Binding Text}"/>
                    <Grid ColumnDefinitions="*,9,*">
                        <Button x:Name="btnDiracImportFile" Grid.Column="0" Classes="diracSmall">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <Viewbox Width="14" Height="14"><Path Data="M12 16V2 M7 7l5-5 5 5 M3 16v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4" Stroke="#C6CCCE" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                                <TextBlock Text="Из файла" FontSize="11"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="btnDiracImportClipboard" Grid.Column="2" Classes="diracSmall">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                <Viewbox Width="14" Height="14"><Path Data="M8 4H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V6a2 2 0 0 0-2-2h-2 M9 2h6a1 1 0 0 1 1 1v3H8V3a1 1 0 0 1 1-1z" Stroke="#C6CCCE" StrokeThickness="1.7" StrokeLineCap="Round" StrokeLineJoin="Round" Fill="Transparent"/></Viewbox>
                                <TextBlock Text="Из буфера" FontSize="11"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Button x:Name="btnDiracRoutingShortcut" Classes="diracNav" Padding="0,8" HorizontalContentAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock x:Name="txtDiracMode" Text="Россия напрямую" Foreground="#A8AFB3" FontSize="11" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="›" Foreground="#A8AFB3" FontSize="20" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <TextBlock x:Name="txtDiracProfileCount" Text="Нет профилей" IsVisible="False"/>
                </StackPanel>
            </Grid>

            <StackPanel x:Name="panelDiracRouting" IsVisible="False" Spacing="17">
                <TextBlock Text="Маршрутизация" Foreground="#F0F1F1" FontSize="23" FontWeight="Medium"/>
                <TextBlock Text="Выберите способ обработки трафика." Foreground="#969EA4" FontSize="12" Margin="0,-8,0,8"/>
                <Button x:Name="btnDiracRussia" Classes="diracRow selected">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Россия напрямую" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="Российские ресурсы открываются напрямую. Остальной трафик — через VPN." TextWrapping="Wrap" Foreground="#A5ADB3" FontSize="11"/>
                    </StackPanel>
                </Button>
                <Button x:Name="btnDiracFull" Classes="diracRow">
                    <StackPanel Spacing="7">
                        <TextBlock Text="Полный VPN" FontSize="14" FontWeight="Medium"/>
                        <TextBlock Text="Весь поддерживаемый трафик TUN направляется через VPN." TextWrapping="Wrap" Foreground="#A5ADB3" FontSize="11"/>
                    </StackPanel>
                </Button>
                <TextBlock x:Name="txtDiracRoutingHint" Foreground="#858F96" FontSize="11" TextWrapping="Wrap" Margin="2,5,0,0" Text="Режим сохраняется между запусками."/>
            </StackPanel>

            <StackPanel x:Name="panelDiracUpdates" IsVisible="False" Spacing="17">
                <TextBlock Text="Обновления" Foreground="#F0F1F1" FontSize="23" FontWeight="Medium"/>
                <TextBlock Text="Новые версии приложения через GitHub Releases." TextWrapping="Wrap" Foreground="#969EA4" FontSize="12" Margin="0,-8,0,8"/>
                <TextBlock Text="Канал обновлений" Foreground="#AAB2B7" FontSize="12"/>
                <Grid ColumnDefinitions="*,9,*">
                    <Button x:Name="btnDiracStable" Classes="diracRow selected" Grid.Column="0" Content="Stable" HorizontalContentAlignment="Center"/>
                    <Button x:Name="btnDiracBeta" Classes="diracRow" Grid.Column="2" Content="Beta" HorizontalContentAlignment="Center"/>
                </Grid>
                <Button x:Name="btnDiracCheckUpdate" Classes="diracRow" Content="Проверить обновления" HorizontalContentAlignment="Center" Margin="0,8,0,0"/>
                <TextBlock Text="Профили обновляются только вручную." Foreground="#858F96" FontSize="11" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel x:Name="panelDiracSettings" IsVisible="False" Spacing="15">
                <TextBlock Text="Настройки" Foreground="#F0F1F1" FontSize="23" FontWeight="Medium"/>
                <TextBlock Text="Дополнительные возможности Dirac." Foreground="#969EA4" FontSize="12" Margin="0,-8,0,7"/>
                <Button x:Name="btnDiracProfiles" Classes="diracRow" Content="Управление профилями"/>
                <Button x:Name="btnDiracDiagnostics" Classes="diracRow" Content="Журнал и диагностика"/>
                <Button x:Name="btnDiracAdvanced" Classes="diracRow" Content="Расширенные настройки v2rayN"/>
                <TextBlock Text="Сетевые настройки не изменяются при открытии этих страниц." Foreground="#858F96" FontSize="11" TextWrapping="Wrap" Margin="2,7,0,0"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>