<UserControl
    x:Class="v2rayN.Desktop.Views.DiracHomeView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:DataType="vms:MainWindowViewModel"
    Background="#0A111D">

    <UserControl.Styles>
        <Style Selector="Button.diracNav">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#9DADBE" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.diracNav:pointerover">
            <Setter Property="Background" Value="#1A3043" />
            <Setter Property="Foreground" Value="#F4FAFF" />
        </Style>
        <Style Selector="Button.diracNav.selected">
            <Setter Property="Background" Value="#183D3B" />
            <Setter Property="Foreground" Value="#70F4C5" />
        </Style>
        <Style Selector="Button.diracPrimary">
            <Setter Property="Background" Value="#53E1AC" />
            <Setter Property="Foreground" Value="#10231F" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="18,12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Button.diracPrimary:pointerover">
            <Setter Property="Background" Value="#91FFD5" />
        </Style>
        <Style Selector="Button.diracSecondary">
            <Setter Property="Background" Value="#1D3042" />
            <Setter Property="Foreground" Value="#E8F1F8" />
            <Setter Property="BorderBrush" Value="#35516A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.diracSecondary:pointerover">
            <Setter Property="Background" Value="#28445A" />
        </Style>
        <Style Selector="Button.diracOption">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Background" Value="#142436" />
            <Setter Property="Foreground" Value="#B8C6D4" />
            <Setter Property="BorderBrush" Value="#294054" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Padding" Value="16,14" />
        </Style>
        <Style Selector="Button.diracOption:pointerover">
            <Setter Property="BorderBrush" Value="#54BEAA" />
            <Setter Property="Background" Value="#203C47" />
        </Style>
        <Style Selector="Button.diracOption.selected">
            <Setter Property="Background" Value="#1C403E" />
            <Setter Property="BorderBrush" Value="#60D9AF" />
            <Setter Property="Foreground" Value="#8CF4CA" />
        </Style>
        <Style Selector="Button.diracChannel">
            <Setter Property="Background" Value="#142436" />
            <Setter Property="Foreground" Value="#A2B2C4" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="16,10" />
        </Style>
        <Style Selector="Button.diracChannel.selected">
            <Setter Property="Background" Value="#28594F" />
            <Setter Property="Foreground" Value="#BBFFE4" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="220,*">
        <!-- A small, stable navigation shell, not another v2rayN settings tree. -->
        <Border Grid.Column="0" Padding="23,30,18,22" Background="#101C2A"
                BorderBrush="#263849" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,56,Auto,Auto,Auto,*,Auto,16,Auto">
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11">
                    <Border Width="42" Height="42" Background="#234F48" CornerRadius="12">
                        <TextBlock Text="D" FontSize="24" FontWeight="Bold" Foreground="#93FDD0"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="DIRAC" FontSize="23" FontWeight="Bold" Foreground="#F5FAFF"
                                  />
                        <TextBlock Text="DESKTOP  ·  PREVIEW" Foreground="#7695A5" FontSize="9"
                                  />
                    </StackPanel>
                </StackPanel>

                <Button Grid.Row="2" x:Name="btnDiracOverview" Classes="diracNav selected" Content="⌂   Главная" />
                <Button Grid.Row="3" x:Name="btnDiracProfiles" Classes="diracNav" Content="▤   Профили" Margin="0,5,0,0"/>
                <Button Grid.Row="4" x:Name="btnDiracDiagnostics" Classes="diracNav" Content="≡   Журнал и диагностика" Margin="0,5,0,0"/>

                <Border Grid.Row="6" Padding="14" CornerRadius="14" Background="#172B39">
                    <StackPanel Spacing="7">
                        <TextBlock Text="DIRAC CORE" Foreground="#82AAAE" FontSize="10" FontWeight="Bold"
                                  />
                        <TextBlock Text="Xray · Native TUN" Foreground="#D7E4EC" FontSize="12"/>
                        <TextBlock Text="Тестовая версия интерфейса"
                                   Foreground="#87A3B3" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
                <Button Grid.Row="8" x:Name="btnDiracAdvanced" Classes="diracNav" Content="⚙   Расширенные настройки" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="36,29,38,30" Spacing="21">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="6">
                        <TextBlock Text="Главная" FontSize="27" FontWeight="Bold" Foreground="#F0F6FA"/>
                        <TextBlock Text="Управление подключением и маршрутизацией"
                                   FontSize="13" Foreground="#91A7B8"/>
                    </StackPanel>
                    <Border Grid.Column="1" VerticalAlignment="Top" Background="#1C3539"
                            BorderBrush="#2B6058" BorderThickness="1" CornerRadius="30"
                            Padding="13,7">
                        <TextBlock x:Name="txtDiracHeaderStatus" Foreground="#B4ECD8"
                                   FontSize="12" FontWeight="SemiBold" Text="●  Отключено"/>
                    </Border>
                </Grid>

                <Grid ColumnDefinitions="1.1*,18,0.9*">
                    <Border Grid.Column="0" MinHeight="352" Background="#132335" BorderBrush="#284053"
                            BorderThickness="1" CornerRadius="24" Padding="25,23">
                        <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">
                            <TextBlock Grid.Row="0" Text="VPN-СОЕДИНЕНИЕ" FontSize="11" FontWeight="Bold"
                                       Foreground="#7FABB5"/>
                            <Button x:Name="btnDiracConnect" Grid.Row="1"
                                    Width="164" Height="164" CornerRadius="90" Background="#20483F"
                                    BorderThickness="2" BorderBrush="#62DAB2" Foreground="#AEFFDD"
                                    FontSize="69" FontWeight="Light" Content="⏻"
                                    HorizontalAlignment="Center" VerticalAlignment="Center"
                                    Margin="0,11"/>
                            <TextBlock x:Name="txtDiracConnection" Grid.Row="2" Text="Отключено"
                                       FontSize="26" FontWeight="Bold" Foreground="#F5FBFE"
                                       HorizontalAlignment="Center" TextAlignment="Center"/>
                            <TextBlock x:Name="txtDiracConnectionHint" Grid.Row="3"
                                       Text="Импортируйте профиль и подключайтесь"
                                       FontSize="12" Foreground="#97B3C1" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap"
                                       Margin="8,9,8,15"/>
                            <Border Grid.Row="4" CornerRadius="11" Background="#1B3443" Padding="13,10">
                                <Grid ColumnDefinitions="Auto,*">
                                    <TextBlock Text="◈  DNS" Foreground="#7FE3CB" FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock x:Name="txtDiracDns" Grid.Column="1" HorizontalAlignment="Right"
                                               Text="Активируется вместе с VPN" Foreground="#A4BCCB" FontSize="11"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="#132335" BorderBrush="#284053"
                            BorderThickness="1" CornerRadius="24" Padding="21,22">
                        <StackPanel Spacing="13">
                            <TextBlock Text="МАРШРУТИЗАЦИЯ" FontSize="11" FontWeight="Bold"
                                       Foreground="#7FABB5"/>
                            <TextBlock Text="Выберите режим" FontSize="19" FontWeight="Bold"
                                       Foreground="#F0F8FC" Margin="0,2,0,2"/>
                            <Button x:Name="btnDiracRussia" Classes="diracOption selected">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="◉   Россия напрямую" FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="RU-сайты без VPN, остальное через сервер."
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnDiracFull" Classes="diracOption">
                                <StackPanel Spacing="5">
                                    <TextBlock Text="◉   Полный VPN" FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Весь трафик TUN через VPN-сервер."
                                               FontSize="11" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="txtDiracRoutingHint" FontSize="11" Foreground="#88ACBB"
                                       Text="Режим сохраняется между запусками."
                                       TextWrapping="Wrap" Margin="2,5,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="#132335" BorderBrush="#284053"
                        BorderThickness="1" CornerRadius="22" Padding="22,21">
                    <StackPanel Spacing="13">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Spacing="5">
                                <TextBlock Text="Ваш профиль" FontSize="19" FontWeight="Bold" Foreground="#F1F7FC"/>
                                <TextBlock Text="Конфигурация поступает только от владельца сервера."
                                           Foreground="#91ACBB" FontSize="11" TextWrapping="Wrap"/>
                            </StackPanel>
                            <TextBlock x:Name="txtDiracProfileCount" Grid.Column="1"
                                       VerticalAlignment="Center" Foreground="#96C9BA" FontSize="12"
                                       Text="Нет профилей"/>
                        </Grid>
                        <ComboBox x:Name="cmbDiracProfile" MinHeight="44"
                                  Background="#20354A" Foreground="#E8F5F8"
                                  HorizontalAlignment="Stretch"
                                  ItemsSource="{Binding StatusBarViewModel.Servers}"
                                  SelectedItem="{Binding StatusBarViewModel.SelectedServer, Mode=TwoWay}"
                                  DisplayMemberBinding="{Binding Text}"/>
                        <Grid ColumnDefinitions="*,12,*">
                            <Button Grid.Column="0" x:Name="btnDiracImportFile" Classes="diracPrimary"
                                    Content="＋  Импорт из файла"/>
                            <Button Grid.Column="2" x:Name="btnDiracImportClipboard" Classes="diracSecondary"
                                    Content="▤  Из буфера обмена"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="#132335" BorderBrush="#284053"
                        BorderThickness="1" CornerRadius="22" Padding="22,20">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="22">
                        <StackPanel Spacing="7">
                            <TextBlock Text="Обновления приложения" FontSize="18" FontWeight="Bold"
                                       Foreground="#F1F7FC"/>
                            <TextBlock Text="GitHub Releases · без обновления ваших профилей"
                                       FontSize="11" Foreground="#91ACBB" TextWrapping="Wrap"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Button x:Name="btnDiracStable" Classes="diracChannel selected" Content="Stable"/>
                                <Button x:Name="btnDiracBeta" Classes="diracChannel" Content="Beta"/>
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="btnDiracCheckUpdate" Grid.Column="1"
                                Classes="diracSecondary" Content="Проверить обновления"
                                VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <TextBlock Text="DIRAC DESKTOP  ·  ПРЕДВАРИТЕЛЬНЫЙ ИНТЕРФЕЙС  ·  WINDOWS IPv4 TUN"
                           HorizontalAlignment="Center" Foreground="#537284"
                           FontSize="10"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
